rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read all collection owners (top-level docs)
    match /Collections/{ownerId} {
      allow read: if request.auth != null;
      allow write: if false; // Prevent direct writes to collection owners, if you want
    }

    // Allow read/write on Cards and Sold_Cards subcollections for all authenticated users
    match /Collections/{ownerId}/Cards/{cardId} {
      allow read, write: if request.auth != null;
    }
    match /Collections/{ownerId}/Sold_Cards/{cardId} {
      allow read, write: if request.auth != null;
    }
  }
}
